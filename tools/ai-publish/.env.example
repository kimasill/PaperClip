# GitLab (필수: MR 생성 시)
GITLAB_TOKEN=glpat-xxxxxxxx
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=12345678
# 또는 네임스페이스 경로 (URL 인코딩): mygroup%2Fmyproject

# 대상 브랜치 (기본: 자동 감지 origin/HEAD 또는 main)
TARGET_BRANCH=master

# 리뷰어: 쉼표 구분 숫자 ID
GITLAB_REVIEWER_IDS=101,102
# 또는 사용자명 (API로 ID 조회)
GITLAB_REVIEWER_USERNAMES=alice,bob

# 담당자 (선택)
GITLAB_ASSIGNEE_IDS=

# Obsidian Vault 루트 (리포트 .md 저장 위치)
OBSIDIAN_VAULT=C:\Users\YOU\OneDrive\문서\Obsidian Vault

# 리포트 상대 폴더 (Vault 루트 기준)
OBSIDIAN_REPORTS_DIR=AI_Reports

# 에이전트의 JWT 토큰 스코프 제한을 해제하거나 관리자(Board) 권한을 허용하는 옵션 추가
PAPERCLIP_ALLOW_AGENT_ADMIN_API=true
PAPERCLIP_INSECURE_PLUGIN_API=true